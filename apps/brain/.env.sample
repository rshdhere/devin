BRAIN_PORT=9092
DATABASE_URL=postgresql://user:pass@host:5432/devin
EXECUTION_WORKER_URL=http://execution-host:9091
# Orchestrator (sandbox provisioning)
# EKS brain/worker in cluster: http://devin-orchestrator-lb.devin-system.svc:9090
# EC2 worker: filled by sudo devin-infra sync-platform-config from SSM
ORCHESTRATOR_URL=http://localhost:9090
DEFAULT_AGENT=cursor

# Keep follow-up / session recovery available this many days (default 30)
# SESSION_RETENTION_DAYS=30

# Optional HydraDB long-lived session context (ingest + recall on continue)
# HYDRADB_API_KEY=
# HYDRADB_TENANT_ID=
# HYDRADB_BASE_URL=https://api.hydradb.com
# HYDRADB_SUB_TENANT_ID=

# Point API server SCHEDULER_URL at this brain service in cloud deployments.
