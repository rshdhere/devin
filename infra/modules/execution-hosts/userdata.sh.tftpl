#!/bin/bash
set -euo pipefail

# Bootstrap Firecracker execution hosts (Path B).
# Installs the Go CLI (devin-infra), writes systemd units, and syncs platform
# config from SSM. Snapshots are built separately — see infra/README-cli.md.

export DEBIAN_FRONTEND=noninteractive
export AWS_REGION="${aws_region}"
export DEVIN_SSM_PREFIX="${ssm_parameter_prefix}"
export DEVIN_HOST_NAME="${host_name}"
export DEVIN_CONTAINER_REGISTRY="${container_registry}"
export DEVIN_IMAGE_TAG="${image_tag}"

mkdir -p /etc/devin
echo "${host_name}" >/etc/devin/host-name
chmod 644 /etc/devin/host-name

apt-get update -y
apt-get install -y curl ca-certificates gnupg jq unzip

# AWS CLI v2 (the awscli apt package is unavailable on Ubuntu 24.04 noble)
if ! command -v aws &>/dev/null; then
  tmpdir="$(mktemp -d)"
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "$tmpdir/awscliv2.zip"
  unzip -q "$tmpdir/awscliv2.zip" -d "$tmpdir"
  "$tmpdir/aws/install"
  rm -rf "$tmpdir"
fi

# SSM Agent — required for Session Manager on private execution hosts
if ! systemctl is-active --quiet amazon-ssm-agent 2>/dev/null; then
  tmpdir="$(mktemp -d)"
  curl -fsSL -o "$tmpdir/amazon-ssm-agent.deb" \
    https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/debian_amd64/amazon-ssm-agent.deb
  dpkg -i "$tmpdir/amazon-ssm-agent.deb" || apt-get install -f -y
  rm -rf "$tmpdir"
  systemctl enable --now amazon-ssm-agent
fi

if ! command -v docker &>/dev/null; then
  curl -fsSL https://get.docker.com | sh
  systemctl enable --now docker
fi

mkdir -p /etc/cni/conf.d /opt/cni/bin /var/lib/devin/linux /var/lib/devin/snapshots /var/lib/devin/vms

# Install /usr/local/bin/devin-infra from the published image, or build from git.
install_devin_infra() {
  local image="${container_registry}/devin-infra:${image_tag}"
  if docker pull "$image" >/dev/null 2>&1; then
    docker rm -f devin-infra-extract >/dev/null 2>&1 || true
    docker create --name devin-infra-extract "$image" >/dev/null
    docker cp devin-infra-extract:/usr/local/bin/devin-infra /usr/local/bin/devin-infra
    docker rm -f devin-infra-extract >/dev/null 2>&1 || true
    chmod 755 /usr/local/bin/devin-infra
    return 0
  fi

  echo "devin-infra image unavailable; building CLI from source" >&2
  apt-get install -y git golang-go
  local build_dir=/opt/devin-build
  if [[ -d "$${build_dir}/.git" ]]; then
    git -C "$${build_dir}" fetch --depth 1 origin main
    git -C "$${build_dir}" reset --hard origin/main
  else
    rm -rf "$${build_dir}"
    git clone --depth 1 --branch main https://github.com/rshdhere/devin.git "$${build_dir}"
  fi
  (cd "$${build_dir}/infra" && go build -o /usr/local/bin/devin-infra ./cmd/devin-infra)
  chmod 755 /usr/local/bin/devin-infra
}

install_devin_infra
/usr/local/bin/devin-infra fix-sandbox-dns

# Systemd unit templates — ORCHESTRATOR_URL is filled by sync-platform-config
cat >/etc/systemd/system/devin-firecracker.service <<UNIT
[Unit]
Description=devin.baby firecracker
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=/bin/bash -c 'rm -rf /var/lib/cni/networks/fcnet || true'
ExecStart=/usr/bin/docker run --rm --name firecracker \\
  --privileged \\
  --network host \\
  -v /dev/kvm:/dev/kvm \\
  -v /var/lib/devin:/var/lib/devin \\
  -e FIRECRACKER_DRY_RUN=false \\
  -e FIRECRACKER_HOST_PORT=9092 \\
  -e FIRECRACKER_HOST_NAME=${host_name} \\
  -e FIRECRACKER_POOL_SIZE=1 \\
  -e FIRECRACKER_DEFAULT_RUNTIME=nextjs \\
  -e FIRECRACKER_SNAPSHOT_DIR=/var/lib/devin/snapshots \\
  -e FIRECRACKER_KERNEL_PATH=/var/lib/devin/linux/vmlinux \\
  -e FIRECRACKER_VMM_DIR=/var/lib/devin/vms \\
  -e FIRECRACKER_RUNTIME_PORT=8081 \\
  -e FIRECRACKER_WARM_VCPU=2 \\
  -e FIRECRACKER_WARM_MEMORY_MIB=8192 \\
  -e FIRECRACKER_CNI_NETWORK=fcnet \\
  -e FIRECRACKER_CNI_CONF_DIR=/etc/cni/conf.d \\
  -e FIRECRACKER_CNI_BIN_PATH=/opt/cni/bin \\
  -e FIRECRACKER_CAPACITY_CPU=2 \\
  -e FIRECRACKER_CAPACITY_MEMORY=16Gi \\
  ${container_registry}/devin-firecracker:${image_tag}
ExecStop=/usr/bin/docker stop firecracker

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/systemd/system/devin-scheduler.service <<UNIT
[Unit]
Description=devin.baby scheduler
After=devin-firecracker.service
Wants=devin-firecracker.service

[Service]
Restart=always
RestartSec=5
Environment=ORCHESTRATOR_URL=http://pending-ssm-sync:9090
ExecStart=/usr/bin/docker run --rm --name scheduler \\
  --network host \\
  --env-file /etc/devin/scheduler-secrets.env \\
  -e SCHEDULER_PORT=9091 \\
  -e ORCHESTRATOR_URL=$${ORCHESTRATOR_URL} \\
  -e FIRECRACKER_HOST_URL=http://127.0.0.1:9092 \\
  -e SCHEDULER_HOST_NAME=${host_name} \\
  -e FIRECRACKER_HOST_NAME=${host_name} \\
  -e QUEUE_DRIVER=$${QUEUE_DRIVER} \\
  -e SQS_QUEUE_URL=$${SQS_QUEUE_URL} \\
  -e AWS_REGION=${aws_region} \\
  -e DEFAULT_AGENT=cursor \\
  -e SANDBOX_READY_TIMEOUT_SECONDS=300 \\
  -e RUNTIME_READY_TIMEOUT_SECONDS=60 \\
  -e AGENT_RUN_TIMEOUT_MIN=60 \\
  ${container_registry}/devin-scheduler:${image_tag}
ExecStop=/usr/bin/docker stop scheduler

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/systemd/system/devin-platform-sync.service <<UNIT
[Unit]
Description=Sync devin.baby platform config from SSM
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=AWS_REGION=${aws_region}
Environment=DEVIN_SSM_PREFIX=${ssm_parameter_prefix}
ExecStart=/usr/local/bin/devin-infra sync-platform-config
UNIT

cat >/etc/systemd/system/devin-platform-sync.timer <<'UNIT'
[Unit]
Description=Periodically sync devin.baby platform config from SSM

[Timer]
OnBootSec=30
OnUnitActiveSec=120
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now devin-platform-sync.timer
/usr/local/bin/devin-infra sync-platform-config || true

if [[ -d /dev/kvm && ! -c /dev/kvm ]]; then
  echo "WARNING: /dev/kvm is a directory — remove before starting firecracker" >&2
elif [[ ! -c /dev/kvm ]]; then
  echo "WARNING: /dev/kvm not found — enable nested virtualization (devin-infra enable-nested-virt)" >&2
fi

echo "Execution host ${host_name} bootstrapped with devin-infra."
echo "Platform URLs sync from SSM prefix ${ssm_parameter_prefix}"
echo "Next: build snapshots via: devin-infra bootstrap-snapshots <instance-id>"
