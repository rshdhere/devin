{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@devin/secrets": ["../../packages/secrets/src/index.ts"],
      "@devin/secrets/*": ["../../packages/secrets/src/*"],
      "@devin/types": ["../../packages/types/src/index.ts"],
      "@devin/types/*": ["../../packages/types/src/*"],
      "@scheduler/*": ["../../packages/scheduler/src/*"],
      "@harness/*": ["../../apps/brain/src/harness/src/*"],
      "@web/*": ["../../apps/web/*"]
    }
  },
  "include": ["packages/**/*", "apps/**/*", "tests/**/*", "vitest.config.ts"]
}
